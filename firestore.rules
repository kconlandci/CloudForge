rules_version = '2';

// CloudForge — Firestore Security Rules
// Carried over unchanged from ThreatForge's Phase 1 rules: the data
// paths are identical (users/{uid} progress doc + users/{uid}/events
// analytics subcollection), so no CloudForge-specific changes.
// Each anonymous user may only read/write their own document and
// their own analytics events. No cross-user access, no public reads.
//
// Deploy with:  firebase deploy --only firestore:rules
// (requires the Firebase CLI authenticated to CloudForge's project,
// or paste into Firebase Console > Firestore Database > Rules)

service cloud.firestore {
  match /databases/{database}/documents {
    // Progress doc: users/{firebaseAuthUid}
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Analytics events subcollection: users/{uid}/events/{eventId}
    match /users/{uid}/events/{eventId} {
      allow read, create: if request.auth != null && request.auth.uid == uid;
    }
  }
}
